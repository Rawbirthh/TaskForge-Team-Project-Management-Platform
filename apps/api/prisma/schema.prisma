generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Infrastructure-only table used to verify migrations, seed repeatability, and
/// database readiness. It is not a product entity.
model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.VarChar(500)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  displayName         String    @map("display_name")
  timeZone            String    @default("UTC") @map("time_zone") @db.VarChar(64)
  locale              String?   @map("locale") @db.VarChar(35)
  avatarUrl           String?   @map("avatar_url") @db.VarChar(500)
  pendingEmail        String?   @unique @map("pending_email") @db.VarChar(254)
  emailVerifiedAt     DateTime? @map("email_verified_at")
  deactivatedAt       DateTime? @map("deactivated_at")
  deletionRequestedAt DateTime? @map("deletion_requested_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  emailChangeTokens       EmailChangeToken[]
  workspaceMemberships      WorkspaceMembership[]
  workspaceInvitationsSent  WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
  workspaceInvitationsAccepted WorkspaceInvitation[] @relation("WorkspaceInvitationsAccepted")
  createdProjects              Project[]

  @@map("users")
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String    @map("new_email") @db.VarChar(254)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_change_tokens")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST

  @@map("workspace_role")
}

enum WorkspaceMembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED

  @@map("workspace_membership_status")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(80)
  slug        String   @unique @db.VarChar(48)
  description String?  @db.VarChar(500)
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  memberships   WorkspaceMembership[]
  invitations  WorkspaceInvitation[]
  projects      Project[]

  @@map("workspaces")
}

model WorkspaceMembership {
  id          String                   @id @default(cuid())
  workspaceId String                   @map("workspace_id")
  userId      String                   @map("user_id")
  role        WorkspaceRole            @default(MEMBER)
  status      WorkspaceMembershipStatus @default(ACTIVE)
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
  @@map("workspace_memberships")
}

model Session {
  id                       String    @id @default(cuid())
  userId                   String    @map("user_id")
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  rotatedAt                DateTime? @map("rotated_at")
  expiresAt                DateTime  @map("expires_at")
  revokedAt                DateTime? @map("revoked_at")
  userAgent                String?   @map("user_agent") @db.VarChar(512)
  ipAddress                String?   @map("ip_address") @db.VarChar(64)
  createdAt                DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

model WorkspaceInvitation {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  email           String    @db.VarChar(254)
  role            WorkspaceRole @default(MEMBER)
  tokenHash       String    @unique @map("token_hash")
  invitedByUserId String    @map("invited_by_user_id")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  acceptedUserId  String?   @map("accepted_user_id")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User      @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedUser User?     @relation("WorkspaceInvitationsAccepted", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([workspaceId, createdAt])
  @@map("workspace_invitations")
}

enum ProjectVisibility {
  WORKSPACE
  PRIVATE

  @@map("project_visibility")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED

  @@map("project_status")
}

model Project {
  id              String            @id @default(cuid())
  workspaceId     String            @map("workspace_id")
  key             String            @db.VarChar(16)
  name            String            @db.VarChar(120)
  description     String?           @db.VarChar(2000)
  visibility      ProjectVisibility @default(WORKSPACE)
  status          ProjectStatus     @default(ACTIVE)
  startDate       DateTime?         @map("start_date") @db.Date
  targetDate      DateTime?         @map("target_date") @db.Date
  createdByUserId String            @map("created_by_user_id")
  archivedAt      DateTime?         @map("archived_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, key])
  @@unique([workspaceId, name])
  @@index([workspaceId, status, visibility])
  @@index([workspaceId, updatedAt, id])
  @@index([workspaceId, createdAt])
  @@map("projects")
}
