# Copy to apps/api/.env and replace the placeholder password.
# Local XAMPP MariaDB 10.4 instance listening on port 3309.
NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://taskforge:change-me@127.0.0.1:3309/taskforge"
SHADOW_DATABASE_URL="mysql://taskforge:change-me@127.0.0.1:3309/taskforge_shadow"
CORS_ORIGINS="http://localhost:5173"
LOG_LEVEL=debug
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
APP_VERSION=0.1.0

# Authentication (Feature 5). Replace JWT_ACCESS_SECRET with at least 32 random characters.
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
JWT_ISSUER=taskforge-api
JWT_AUDIENCE=taskforge-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_CHANGE_TOKEN_TTL_HOURS=24
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
MAIL_PROVIDER=console
APP_PUBLIC_URL=http://localhost:5173
# SMTP settings are required only when MAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
